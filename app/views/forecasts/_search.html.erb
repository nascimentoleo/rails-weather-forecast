<% content_for :title, "Weather Forecast" %>

<header class="mb-8">
  <h1 class="text-3xl font-semibold tracking-tight">Weather Forecast</h1>
  <p class="mt-2 text-slate-600">Enter a US address to see the current temperature and the forecast for its zip code.</p>
</header>

<%= form_with url: forecast_path, method: :get, data: { turbo_frame: "forecast", turbo_action: "advance" }, class: "rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200" do |form| %>
  <div>
    <%= form.label :address, "Address", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :address, value: params[:address], required: true, maxlength: Address::Input::MAX_LENGTH, placeholder: "1180 Seven Seas Dr, Lake Buena Vista, FL", autofocus: true, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-4">
    <div>
      <%= form.label :units, "Units", class: "block text-sm font-medium text-slate-700" %>
      <%= form.select :units, [ [ "Celsius (°C)", "celsius" ], [ "Fahrenheit (°F)", "fahrenheit" ] ], { selected: params[:units] || Forecast::Input::DEFAULT_UNITS }, class: "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
    </div>

    <div>
      <%= form.label :days, "Days", class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :days, value: params[:days] || Forecast::Input::DEFAULT_DAYS, min: 1, max: Forecast::Input::MAX_DAYS, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-200" %>
    </div>
  </div>

  <%= form.submit "Get forecast", class: "mt-6 w-full cursor-pointer rounded-lg bg-sky-600 px-4 py-2.5 font-medium text-white shadow-sm hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-300 disabled:cursor-wait disabled:opacity-60" %>
<% end %>
