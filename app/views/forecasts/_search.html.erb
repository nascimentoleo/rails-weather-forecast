<% content_for :title, "Weather Forecast" %>

<header class="mb-8">
  <h1 class="text-3xl font-semibold tracking-tight">Weather Forecast</h1>
  <p class="mt-2 text-slate-600">
    Search for a US address, then pick it from the list to see the current temperature and the forecast for its zip code.
  </p>
</header>

<%= form_with url: forecast_path, method: :get, class: "card" do |form| %>
  <%= form.button "Find addresses",
        type: "submit",
        hidden: true,
        formaction: addresses_path,
        formmethod: "get",
        data: { turbo_frame: "address_options" } %>

  <%= render "addresses/search_field", form: form %>

  <div class="mt-4 grid grid-cols-2 gap-4">
    <div>
      <%= form.label :units, "Units", class: "label" %>
      <%= form.select :units,
            { "Celsius (°C)" => "celsius", "Fahrenheit (°F)" => "fahrenheit" },
            { selected: params[:units] || Forecast::Input::DEFAULT_UNITS },
            class: "input" %>
    </div>

    <div>
      <%= form.label :days, "Days", class: "label" %>
      <%= form.number_field :days,
            value: params[:days] || Forecast::Input::DEFAULT_DAYS,
            min: 1,
            max: Forecast::Input::MAX_DAYS,
            class: "input" %>
    </div>
  </div>

  <%= form.button "Search", name: nil, class: "button mt-6" %>
<% end %>
