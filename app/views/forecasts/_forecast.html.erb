<section class="card">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm text-slate-500"><%= address.full_address %></p>
      <p class="text-sm text-slate-500">Zip code <span class="font-medium text-slate-700"><%= address.zip %></span></p>
    </div>

    <% if address.from_cache && forecast.from_cache %>
      <span class="badge bg-amber-100 text-amber-800">From cache</span>
    <% else %>
      <span class="badge bg-emerald-100 text-emerald-800">Live</span>
    <% end %>
  </div>

  <div class="mt-6">
    <p class="text-sm font-medium text-slate-500">Current temperature</p>
    <p class="text-6xl font-semibold tracking-tight"><%= temperature(forecast.current_temperature, forecast.units) %></p>
  </div>

  <ul class="mt-8 divide-y divide-slate-100 border-t border-slate-100">
    <% forecast.daily_temperatures.each do |day| %>
      <li class="flex items-center justify-between py-3">
        <span class="text-slate-700"><%= forecast_day(day[:date]) %></span>
        <span class="tabular-nums">
          <span class="font-medium"><%= temperature(day[:high], forecast.units) %></span>
          <span class="ml-2 text-slate-400"><%= temperature(day[:low], forecast.units) %></span>
        </span>
      </li>
    <% end %>
  </ul>
</section>
